generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  name         String?
  password     String?
  isVerified   Boolean   @default(false) @map("is_verified")
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  apiKeys   ApiKey[]
  sessions  WhatsAppSessionRecord[]
  templates MessageTemplate[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  key        String    @unique
  name       String    @default("Default Key")
  userId     String    @map("user_id")
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@map("api_keys")
}

model WhatsAppSessionRecord {
  id          String   @id @default(uuid())
  sessionId   String   @unique @map("session_id")
  userId      String   @map("user_id")
  phoneNumber String?  @map("phone_number")
  status      String   @default("disconnected")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("whatsapp_sessions")
}

model MessageLog {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  apiKey       String?  @map("api_key")
  recipient    String
  messageType  String   @default("otp") @map("message_type")
  messageId    String?  @map("message_id")
  // Snapshot of the template used, kept even if the template is later deleted
  templateId   String?  @map("template_id")
  templateName String?  @map("template_name")
  status       String   @default("sent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([apiKey])
  @@map("message_logs")
}

model MessageTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  body      String
  variables String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("message_templates")
}
